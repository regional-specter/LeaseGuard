{
  "$defs": {
    "AnswerStatus": {
      "description": "Evidence status for a document-grounded answer.",
      "enum": [
        "answered",
        "insufficient_evidence",
        "conflicting_evidence",
        "unreadable_source"
      ],
      "title": "AnswerStatus",
      "type": "string"
    },
    "EvidenceSpan": {
      "additionalProperties": false,
      "description": "Exact text supporting an extracted fact or answer.",
      "properties": {
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "end_char": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Char"
        },
        "page_label": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Label"
        },
        "page_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Number"
        },
        "section": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "start_char": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Char"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "text"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "StakeholderPerspective": {
      "description": "Perspective requested for an explanation.",
      "enum": [
        "landlord",
        "tenant",
        "neutral"
      ],
      "title": "StakeholderPerspective",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Simple and structured answer grounded in one or more evidence spans.",
  "properties": {
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceSpan"
      },
      "title": "Evidence",
      "type": "array"
    },
    "explanation": {
      "minLength": 1,
      "title": "Explanation",
      "type": "string"
    },
    "perspective": {
      "$ref": "#/$defs/StakeholderPerspective"
    },
    "question": {
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/AnswerStatus"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "question",
    "perspective",
    "status",
    "explanation",
    "confidence"
  ],
  "title": "DocumentAnswer",
  "type": "object"
}
