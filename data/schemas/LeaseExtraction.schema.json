{
  "$defs": {
    "AmendmentAction": {
      "description": "How an amendment changes an earlier document.",
      "enum": [
        "add",
        "delete",
        "replace",
        "modify",
        "confirm",
        "other"
      ],
      "title": "AmendmentAction",
      "type": "string"
    },
    "AmendmentEffect": {
      "additionalProperties": false,
      "description": "One explicit change an amendment makes to an earlier lease.",
      "properties": {
        "action": {
          "$ref": "#/$defs/AmendmentAction"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "effect_id": {
          "minLength": 1,
          "title": "Effect Id",
          "type": "string"
        },
        "effective_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Date"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "target_clause_reference": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Clause Reference"
        },
        "target_document_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Document Id"
        }
      },
      "required": [
        "effect_id",
        "action",
        "description",
        "evidence"
      ],
      "title": "AmendmentEffect",
      "type": "object"
    },
    "Clause": {
      "additionalProperties": false,
      "description": "A classified section of lease text.",
      "properties": {
        "clause_id": {
          "minLength": 1,
          "title": "Clause Id",
          "type": "string"
        },
        "clause_types": {
          "items": {
            "$ref": "#/$defs/ClauseType"
          },
          "minItems": 1,
          "title": "Clause Types",
          "type": "array"
        },
        "heading": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heading"
        },
        "page_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page End"
        },
        "page_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Start"
        },
        "summary": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "clause_id",
        "clause_types",
        "text"
      ],
      "title": "Clause",
      "type": "object"
    },
    "ClauseType": {
      "description": "Clause labels supported by ontology version 1.",
      "enum": [
        "parties",
        "premises",
        "property_use",
        "definitions",
        "lease_term",
        "commencement",
        "expiration",
        "renewal_option",
        "extension_option",
        "early_termination",
        "base_rent",
        "additional_rent",
        "rent_increase",
        "rent_abatement",
        "tenant_share",
        "security_deposit",
        "operating_expenses",
        "common_area_maintenance",
        "taxes",
        "insurance",
        "late_fees",
        "percentage_rent",
        "maintenance",
        "repairs",
        "utilities",
        "alterations",
        "tenant_improvements",
        "delivery_condition",
        "access",
        "common_areas",
        "signage",
        "parking",
        "continuous_operation",
        "co_tenancy",
        "exclusivity",
        "radius_restriction",
        "prohibited_use",
        "relocation",
        "assignment",
        "subletting",
        "change_of_control",
        "amendment",
        "notice",
        "holdover",
        "surrender",
        "subordination",
        "non_disturbance",
        "estoppel",
        "liens",
        "brokerage",
        "default",
        "cure_period",
        "remedies",
        "indemnity",
        "liability",
        "damage_and_destruction",
        "condemnation",
        "force_majeure",
        "accessibility",
        "environmental",
        "compliance_with_laws",
        "services",
        "janitorial",
        "security",
        "dispute_resolution",
        "governing_law",
        "guarantee",
        "exhibit",
        "schedule",
        "other"
      ],
      "title": "ClauseType",
      "type": "string"
    },
    "DateTerm": {
      "additionalProperties": false,
      "description": "A source expression and optional normalized calendar date.",
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "normalized_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Date"
        },
        "original_text": {
          "minLength": 1,
          "title": "Original Text",
          "type": "string"
        },
        "trigger": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger"
        }
      },
      "required": [
        "label",
        "original_text",
        "evidence"
      ],
      "title": "DateTerm",
      "type": "object"
    },
    "DocumentType": {
      "description": "Supported document types.",
      "enum": [
        "office_lease",
        "retail_lease",
        "amendment",
        "exhibit",
        "other_related"
      ],
      "title": "DocumentType",
      "type": "string"
    },
    "EvidenceSpan": {
      "additionalProperties": false,
      "description": "Exact text supporting an extracted fact or answer.",
      "properties": {
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "end_char": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Char"
        },
        "page_label": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Label"
        },
        "page_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Number"
        },
        "section": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "start_char": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Char"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "text"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "MonetaryTerm": {
      "additionalProperties": false,
      "description": "A source expression and optional normalized monetary value.",
      "properties": {
        "amount": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "currency": {
          "default": "USD",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "frequency": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frequency"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "original_text": {
          "minLength": 1,
          "title": "Original Text",
          "type": "string"
        },
        "period": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period"
        },
        "rate_basis": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Basis"
        }
      },
      "required": [
        "label",
        "original_text",
        "evidence"
      ],
      "title": "MonetaryTerm",
      "type": "object"
    },
    "Obligation": {
      "additionalProperties": false,
      "description": "An action a named party is required to perform.",
      "properties": {
        "action": {
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "$ref": "#/$defs/MonetaryTerm"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "beneficiary": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Beneficiary"
        },
        "condition": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "due_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due Date"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "obligation_id": {
          "minLength": 1,
          "title": "Obligation Id",
          "type": "string"
        },
        "recurrence": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recurrence"
        },
        "relative_deadline": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relative Deadline"
        },
        "responsible_party": {
          "minLength": 1,
          "title": "Responsible Party",
          "type": "string"
        },
        "timing_type": {
          "$ref": "#/$defs/TimingType"
        },
        "timing_unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimingUnit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "timing_value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timing Value"
        },
        "trigger": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger"
        }
      },
      "required": [
        "obligation_id",
        "responsible_party",
        "action",
        "timing_type",
        "evidence"
      ],
      "title": "Obligation",
      "type": "object"
    },
    "Party": {
      "additionalProperties": false,
      "description": "A named party and its role in the lease.",
      "properties": {
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/PartyRole"
        }
      },
      "required": [
        "name",
        "role",
        "evidence"
      ],
      "title": "Party",
      "type": "object"
    },
    "PartyRole": {
      "description": "Roles a named party may have in a lease.",
      "enum": [
        "landlord",
        "tenant",
        "guarantor",
        "property_manager",
        "other"
      ],
      "title": "PartyRole",
      "type": "string"
    },
    "Premises": {
      "additionalProperties": false,
      "description": "A physical space included in the lease.",
      "properties": {
        "address": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "floor": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Floor"
        },
        "permitted_use": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Permitted Use"
        },
        "property_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Property Name"
        },
        "rentable_square_feet": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rentable Square Feet"
        },
        "suite": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suite"
        },
        "usable_square_feet": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usable Square Feet"
        }
      },
      "required": [
        "description",
        "evidence"
      ],
      "title": "Premises",
      "type": "object"
    },
    "RightsStatus": {
      "description": "Review status for using and redistributing a source.",
      "enum": [
        "public_domain",
        "open_license",
        "permission_granted",
        "review_required",
        "restricted"
      ],
      "title": "RightsStatus",
      "type": "string"
    },
    "SourceDocument": {
      "additionalProperties": false,
      "description": "Identity, provenance, and scope information for one document.",
      "properties": {
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "document_type": {
          "$ref": "#/$defs/DocumentType"
        },
        "family_id": {
          "minLength": 1,
          "title": "Family Id",
          "type": "string"
        },
        "filename": {
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "governing_law_text": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Governing Law Text"
        },
        "is_template": {
          "default": false,
          "title": "Is Template",
          "type": "boolean"
        },
        "jurisdiction": {
          "const": "US",
          "default": "US",
          "title": "Jurisdiction",
          "type": "string"
        },
        "language": {
          "const": "en",
          "default": "en",
          "title": "Language",
          "type": "string"
        },
        "normalized_text_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Text Sha256"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "rights_notes": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rights Notes"
        },
        "rights_status": {
          "$ref": "#/$defs/RightsStatus"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_license": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source License"
        },
        "source_name": {
          "minLength": 1,
          "title": "Source Name",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "state": {
          "anyOf": [
            {
              "minLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State"
        }
      },
      "required": [
        "document_id",
        "family_id",
        "filename",
        "sha256",
        "document_type",
        "source_name",
        "rights_status"
      ],
      "title": "SourceDocument",
      "type": "object"
    },
    "TimingType": {
      "description": "How an obligation's timing is expressed.",
      "enum": [
        "fixed_date",
        "relative_deadline",
        "recurring",
        "event_based",
        "unstated"
      ],
      "title": "TimingType",
      "type": "string"
    },
    "TimingUnit": {
      "description": "Normalized unit for a relative obligation deadline.",
      "enum": [
        "day",
        "business_day",
        "month",
        "year"
      ],
      "title": "TimingUnit",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Complete structured extraction result for one lease document.",
  "properties": {
    "amendment_effects": {
      "items": {
        "$ref": "#/$defs/AmendmentEffect"
      },
      "title": "Amendment Effects",
      "type": "array"
    },
    "clauses": {
      "items": {
        "$ref": "#/$defs/Clause"
      },
      "title": "Clauses",
      "type": "array"
    },
    "date_terms": {
      "items": {
        "$ref": "#/$defs/DateTerm"
      },
      "title": "Date Terms",
      "type": "array"
    },
    "monetary_terms": {
      "items": {
        "$ref": "#/$defs/MonetaryTerm"
      },
      "title": "Monetary Terms",
      "type": "array"
    },
    "obligations": {
      "items": {
        "$ref": "#/$defs/Obligation"
      },
      "title": "Obligations",
      "type": "array"
    },
    "parties": {
      "items": {
        "$ref": "#/$defs/Party"
      },
      "title": "Parties",
      "type": "array"
    },
    "premises": {
      "items": {
        "$ref": "#/$defs/Premises"
      },
      "title": "Premises",
      "type": "array"
    },
    "related_document_ids": {
      "items": {
        "type": "string"
      },
      "title": "Related Document Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceDocument"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "source"
  ],
  "title": "LeaseExtraction",
  "type": "object"
}
